{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/iniciarServidor.ts",
    "start": "node dist/iniciarServidor.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "evals": "tsx evals/correrEvals.ts --live",
    "evals:offline": "tsx evals/correrEvals.ts",
    "mcp:peliculas": "tsx src/mcp/peliculas-tmdb/iniciarPorStdio.ts",
    "mcp:libros": "tsx src/mcp/libros-google/iniciarPorStdio.ts",
    "mcp:navegador": "tsx src/mcp/navegador/iniciarPorStdio.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "groq-sdk": "^0.9.1",
    "open": "^10.1.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^2.1.8",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
