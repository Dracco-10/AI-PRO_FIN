# Copia este archivo como server/.env y llena los valores. NUNCA subas el .env a GitHub.

# LLM (Groq, tier gratuito): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# The Movie Database (registro académico, uso NO comercial, curso CC3116 UVG)
# Usa el "API Read Access Token" (empieza con eyJ...)
TMDB_ACCESS_TOKEN=

# Google Books (opcional, sin tarjeta de crédito). Sin key también funciona con cuota menor.
GOOGLE_BOOKS_API_KEY=

# Puerto del servidor
PORT=3001

# Cómo se abren las pestañas: "server" abre el navegador de la máquina donde corre el server,
# "client" le pide al widget que haga window.open
OPEN_MODE=server
